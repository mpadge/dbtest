er","field_group":"issues"},{"name":"change_req_prop_merged","airtable_name":"Merged change requests","description":"Proportion of change requests which are merged","url":"https://chaoss.community/kb/metric-change-request-acceptance-ratio/","what":"ratio","scale":"none","better":"higher","field_group":"issues"},{"name":"code_change_lines","airtable_name":"Lines of code changed","description":"Total number of code lines changed (added or removed); log-transformed.","url":"https://chaoss.community/kb/metric-code-changes-lines/","what":"count","scale":"log","better":"higher","field_group":"development"},{"name":"commit_count","airtable_name":"Number of commits","description":"Total number of commits made to source code; log-transformed.","url":"https://chaoss.community/kb/metric-code-changes-commits/","what":"count","scale":"log","better":"higher","field_group":"development"},{"name":"committer_count","airtable_name":"Number of committers","description":"Number of individuals who committed to source code","url":"https://chaoss.community/kb/metric-committers/","what":"count","scale":"log","better":"higher","field_group":"development"},{"name":"contrib_absence_commits","airtable_name":"Contributor absence factor","description":"Number of contributors responsible for at least half of all contributions; log-transformed","url":"https://chaoss.community/kb/metric-contributor-absence-factor/","what":"count","scale":"log","better":"higher","field_group":"none"},{"name":"cran_downloads","airtable_name":"CRAN downloads","description":"Number of downloads of packages on CRAN","url":"","what":"count","scale":"log","better":"higher","field_group":"popularity"},{"name":"ctb_count","airtable_name":"Number of contributors","description":"Number of contributors of all kinds (to source code, through issues, pull-requests, comments); log-transformed","url":"https://chaoss.community/kb/metric-contributors/","what":"count","scale":"log","better":"higher","field_group":"development"},{"name":"ctb_diversity","airtable_name":"Diversity of contributors","description":"Simplified version of CHAOSS metrics, measured as total number of non-primary contributors; log-transformed","url":"https://chaoss.community/kb/metric-types-of-contributions/","what":"ratio","scale":"none","better":"higher","field_group":"development"},{"name":"defect_resolution_dur","airtable_name":"Defect resolution duration","description":"Time taken (in days) to resolve defects; log-transformed","url":"https://chaoss.community/kb/defect-resolution-duration/","what":"days","scale":"log","better":"lower","field_group":"issues"},{"name":"dependency_count","airtable_name":"Number of dependencies","description":"Number of dependencies, or number of other packages this package depends on; log-transformed","url":"https://chaoss.community/kb/metric-upstream-code-dependencies/","what":"count","scale":"log","better":"lower","field_group":"meta"},{"name":"elephant_factor","airtable_name":"Elephant factor","description":"To what extent does package depend on single organization? Measure as number of affiliated organizations accounting for at least half of all contributions; log-transformed.","url":"https://chaoss.community/kb/metric-elephant-factor/","what":"count","scale":"log","better":"higher","field_group":"none"},{"name":"has_ci","airtable_name":"Continuous Integration","description":"Does package have continuous integration (true/false)?","url":"","what":"binary","scale":"none","better":"higher","field_group":"development"},{"name":"issue_age","airtable_name":"Issue age","description":"Average age of open issues, in days; log-transformed.","url":"https://chaoss.community/kb/metric-issue-age/","what":"days","scale":"log","better":"lower","field_group":"issues"},{"name":"issue_cmt_count","airtable_name":"Nr. Issue comments","description":"Average number of comments per open issue; log-transformed","url":"https://chaoss.community/kb/metrics-model-community-activity/","what":"count","scale":"log","better":"higher","field_group":"issues"},{"name":"issue_response_time","airtable_name":"Issue response time","description":"Average time (in days) to respond to newly-opened issues; log-transformed.","url":"https://chaoss.community/kb/metric-issue-response-time/","what":"days","scale":"log","better":"lower","field_group":"issues"},{"name":"issue_updates","airtable_name":"Nr. updated issues","description":"Number of open issues updated in recent time period; log-transformed","url":"https://chaoss.community/kb/metrics-model-community-activity/","what":"count","scale":"log","better":"higher","field_group":"issues"},{"name":"issues_active","airtable_name":"Nr. active issues","description":"Number of actively opened or updated issues during recent time period; log-transformed","url":"https://chaoss.community/kb/metric-issues-active/","what":"count","scale":"log","better":"higher","field_group":"issues"},{"name":"issues_closed","airtable_name":"Nr. issues closed","description":"Number of issues closed in recent time period; log-transformed","url":"https://chaoss.community/kb/metrics-model-community-activity/","what":"count","scale":"log","better":"higher","field_group":"issues"},{"name":"issues_to_prs","airtable_name":"Ratio issues / PRs","description":"Ratio of numbers of open issues to open pull requests","url":"https://chaoss.community/kb/metrics-model-community-activity/","what":"ratio","scale":"none","better":"higher","field_group":"issues"},{"name":"label_inclusivity","airtable_name":"Issue label inclusivity","description":"Proportion of recently opened or updated issues with inclusive labels (such as 'Good First Issue').","url":"https://chaoss.community/kb/metric-issue-label-inclusivity/","what":"ratio","scale":"none","better":"higher","field_group":"issues"},{"name":"languages","airtable_name":"Nr. computer languages","description":"Inverse mean proportion of code-lines-per-computer-language. Code distributed across more languages generates lower mean proportions, and so higher inverse values here. Higher values indicated more even distribution across more languages.","url":"https://chaoss.community/?p=3430","what":"real","scale":"none","better":"higher","field_group":"meta"},{"name":"libyears","airtable_name":"Are dependencies up to date?","description":"The CHAOSS 'libyears' metric, which is low or negative when dependencies are up-to-date, and becomes more positive for projects which have not updated their dependencies for longer times. Measured in days, and log-transformed","url":"https://chaoss.community/kb/metric-libyears/","what":"days","scale":"log","better":"lower","field_group":"meta"},{"name":"license_coverage","airtable_name":"Nr. licensed files","description":"'License coverage' metric, as proportion of source code files with explicitly declared licenses","url":"https://chaoss.community/kb/metric-license-coverage/","what":"ratio","scale":"none","better":"higher","field_group":"none"},{"name":"licenses_declared","airtable_name":"License declared?","description":"Does the package declare a recognised open-source license (true/false)?","url":"https://chaoss.community/kb/metric-licenses-declared/","what":"binary","scale":"none","better":"higher","field_group":"none"},{"name":"maintainer_count","airtable_name":"Nr. maintainers","description":"Total number of recently active maintainers, as contributors to source code, issues, or pull requests; log-transformed","url":"https://chaoss.community/kb/metric-committers/","what":"count","scale":"log","better":"higher","field_group":"development"},{"name":"num_commits","airtable_name":"Nr. code changes","description":"Number of code changes, or 'commits', during recent time period; log-transformed","url":"https://chaoss.community/kb/metric-code-changes-commits/","what":"count","scale":"log","better":"higher","field_group":"development"},{"name":"num_contributors","airtable_name":"Nr. code contributors","description":"Total number of recent contributors to source code","url"